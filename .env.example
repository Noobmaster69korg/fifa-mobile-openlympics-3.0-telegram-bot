# Copy this file to .env (and never commit the real .env) or set these
# as environment variables in your hosting platform's dashboard.

# Token from @BotFather
BOT_TOKEN=123456789:AAExampleTokenGoesHere

# Your own Telegram numeric user id (message @userinfobot to get it,
# or deploy once, DM the bot /whoami, then set this and redeploy).
# This account is auto-registered as the first admin on startup.
INITIAL_ADMIN_ID=123456789

# Optional: where the SQLite file is stored. On Railway/Render use a
# path on a mounted persistent volume so data survives restarts.
DB_PATH=handcricket.db
